{
  "manifest_version": 3,
  "name": "CA Compliance Tool - GST Helper",
  "version": "1.2",
  "description": "For CA Compliance Tool: fills a client's GST login (you type the captcha) and checks GSTR-1 / GSTR-3B status on the public Search Taxpayer page.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cacompliancetool.com/*",
        "https://www.cacompliancetool.com/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://services.gst.gov.in/services/searchtp*"
      ],
      "js": [
        "parse.js",
        "portal.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://services.gst.gov.in/services/login*"
      ],
      "js": [
        "login.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
